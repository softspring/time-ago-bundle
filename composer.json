{
    "name": "softspring/time-ago-bundle",
    "description": "This bundle provides a simple twig extension to human readable date diff based on translations",
    "type": "symfony-bundle",
    "license": "AGPL-3.0-or-later",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.89",
        "phpstan/phpstan": "^2.1",
        "rector/rector": "^2.2",
        "symfony/config": "^6.4|^7.4|^8.0",
        "symfony/dependency-injection": "^6.4|^7.4|^8.0",
        "symfony/http-kernel": "^6.4|^7.4|^8.0",
        "symfony/translation": "^6.4|^7.4|^8.0",
        "twig/twig": "*"
    },
    "autoload": {
        "psr-4": {
            "Softspring\\TimeAgoBundle\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
